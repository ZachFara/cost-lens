{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "plugin/hooks/register.tsx",
    "plugin/src/analyzer/cli.ts",
    "plugin/src/terminal/cli.ts",
    "tools/*.ts",
    "tests/**/*.spec.ts",
    "plugin/tests/*.test.{ts,tsx}"
  ],
  "project": [
    "plugin/hooks/**/*.{ts,tsx}",
    "plugin/src/**/*.{ts,tsx}",
    "tools/**/*.ts",
    "tests/**/*.ts",
    "plugin/tests/**/*.{ts,tsx}"
  ],
  "ignoreDependencies": ["claude-code"]
}
